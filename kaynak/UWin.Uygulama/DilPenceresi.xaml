<ContentDialog
    x:Class="UWin.Uygulama.DilPenceresi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">460</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="{StaticResource BolumAraligi}" Padding="0,4,4,4">

        <TextBlock x:Name="AciklamaMetni" Style="{StaticResource GovdeStili}" Opacity="0.75" />

        <!--
          Iki dil de kendi dilinde yazar: Ingilizce arayuzdeki biri
          "Turkish" degil "Turkce" arar, tersi de dogru.
        -->
        <ItemsRepeater x:Name="DilListesi">
            <ItemsRepeater.Layout>
                <StackLayout Spacing="10" />
            </ItemsRepeater.Layout>

            <ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <RadioButton Content="{Binding Ad}"
                                 Tag="{Binding Kod}"
                                 IsChecked="{Binding Secili}"
                                 GroupName="Dil"
                                 Checked="DilSecildi"
                                 FontSize="15"
                                 MinWidth="200" />
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
        </ItemsRepeater>

    </StackPanel>
</ContentDialog>
