<Window
    x:Class="UWin.Uygulama.AnaPencere"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="KokIzgara" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          Ozel baslik cubugu. Pencerenin kendi cubugu kapatilip icerik yukari
          tasindigi icin bu satir sistem cubugunun yerini alir; suruklenebilir
          alan kod tarafinda tanimlanir.
        -->
        <Grid x:Name="BaslikCubugu" Grid.Row="0" Height="48">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <Image x:Name="MarkaSimgesi"
                       Width="18"
                       Height="18" />
                <TextBlock Text="UWin"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Opacity="0.75"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Baslik ve adim gostergesi -->
        <StackPanel Grid.Row="1" Padding="40,12,40,20" Spacing="14">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="AdimSayaci"
                               FontSize="13"
                               Opacity="0.55"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!--
                      Sirada ne var: USB hazirlanmadan once de acilabilir,
                      kullanici yolun tamamini bastan gorebilsin.
                    -->
                    <Button x:Name="SiradaDugmesi"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="SiradaTiklandi">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14" Opacity="0.7" />
                            <TextBlock x:Name="SiradaEtiketi" FontSize="13" Opacity="0.7" />
                        </StackPanel>
                    </Button>

                    <!--
                      Dil: tek tikla degisir. Bayrak kullanilmaz -
                      bayrak ulke demek, dil demek degil; ayrica kucuk
                      boyutta ayirt edilmesi zor.
                    -->
                    <Button x:Name="DilDugmesi"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="DilTiklandi">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xF2B7;" FontSize="14" Opacity="0.7" />
                            <TextBlock x:Name="DilEtiketi" FontSize="13" Opacity="0.7" />
                        </StackPanel>
                    </Button>

                    <!--
                      Araclar: sihirbaz disindaki islemler.
                    -->
                    <Button x:Name="AraclarDugmesi"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="AraclarTiklandi">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE90F;" FontSize="14" Opacity="0.7" />
                            <TextBlock x:Name="AraclarEtiketi" FontSize="13" Opacity="0.7" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HakkindaDugmesi"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,5"
                            Click="HakkindaTiklandi">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Opacity="0.7" />
                            <TextBlock x:Name="HakkindaEtiketi" FontSize="13" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="BaslikMetni"
                       FontSize="30"
                       FontWeight="SemiBold" />

            <ProgressBar x:Name="AdimGostergesi"
                         Height="2"
                         Margin="0,4,0,0" />
        </StackPanel>

        <!-- Aktif adim icerigi -->
        <ScrollViewer Grid.Row="2" Padding="40,4,40,4" VerticalScrollBarVisibility="Auto">
            <Frame x:Name="AdimCercevesi" />
        </ScrollViewer>

        <!-- Gezinme -->
        <Grid Grid.Row="3" Padding="40,20,40,32" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="GeriDugmesi"
                    Grid.Column="0"
                    MinWidth="110"
                    Height="38"
                    Click="GeriTiklandi" />

            <Button x:Name="IleriDugmesi"
                    Grid.Column="2"
                    MinWidth="150"
                    Height="38"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="IleriTiklandi" />
        </Grid>
    </Grid>
</Window>
