<ContentDialog
    x:Class="UWin.Uygulama.SiradaNeVarPenceresi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto"
                  MaxHeight="520"
                  Padding="0,0,20,0"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="0,4,4,4">

            <!--
              Bu ekran USB hazirlanmadan da acilabildigi icin durumu bastan
              soyler. IsOpen bilerek burada verilmez: InfoBar acilirken
              olcusunu hesapladigi icin, basligi kod tarafinda atanmadan
              acilirsa yuksekligi sifir kalir ve hic gorunmez.
            -->
            <InfoBar x:Name="OnizlemeKutusu"
                     Severity="Informational"
                     IsClosable="False" />

            <TextBlock x:Name="AciklamaMetni"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       Opacity="0.85" />

            <!-- BIOS tuslari: en cok aranan bilgi, en ustte ve vurgulu -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="MakineMetni"
                               FontSize="12"
                               Opacity="0.6"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="GirisTusuMetni"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="BootMenuMetni"
                               FontSize="14"
                               Opacity="0.8"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--
              Kurulum amacina gore disk secme ekrani tavsiyesi. Genel
              adimlardan once durur: bu, kullanicinin kurulumda
              yapacagi en kritik ve geri alinamaz secim.
            -->
            <Border x:Name="AmacKutusu"
                    Visibility="Collapsed"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AmacBasligi" FontWeight="SemiBold" />
                    <TextBlock x:Name="AmacMetni"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Opacity="0.85" />

                    <ItemsControl x:Name="AmacAdimListesi" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#x2022;"
                                               Opacity="0.5"
                                               VerticalAlignment="Top" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Uc bolum: BIOS, kurulum, kurulum sonrasi -->
            <ItemsControl x:Name="BolumListesi">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="12" Margin="0,0,0,24">

                            <TextBlock Text="{Binding Baslik}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />

                            <ItemsControl ItemsSource="{Binding Adimlar}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="14" Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Width="24"
                                                    Height="24"
                                                    CornerRadius="12"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Sira}"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding Baslik}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Aciklama}"
                                                           Opacity="0.75"
                                                           TextWrapping="Wrap"
                                                           LineHeight="20" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar x:Name="SecureBootKutusu"
                     Severity="Informational"
                     IsOpen="True"
                     IsClosable="False" />

            <!--
              Kurtarma araclari. USB yalnizca Windows kurmaz; acilmayan
              bir Windows'u onarmak icin de kullanilabilir ve o an
              kullanicinin calisan baska bilgisayari olmayabilir.
            -->
            <StackPanel x:Name="KurtarmaPaneli" Spacing="12" Visibility="Collapsed">

                <TextBlock x:Name="KurtarmaBasligi" FontSize="17" FontWeight="SemiBold" />

                <TextBlock x:Name="KurtarmaNasil"
                           TextWrapping="Wrap"
                           LineHeight="21"
                           Opacity="0.8" />

                <ItemsControl x:Name="KurtarmaListesi">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Ad}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding NeZaman}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap"
                                               LineHeight="19" />
                                    <TextBlock Text="{Binding Dosya}"
                                               Opacity="0.55"
                                               FontSize="12"
                                               FontFamily="Consolas" />
                                    <TextBlock Text="{Binding Uyari}"
                                               Visibility="{Binding UyariGorunurlugu}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Opacity="0.8" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
