<Page
    x:Class="UWin.Uygulama.Adimlar.Adim6YazmaVeRehber"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="{StaticResource SayfaAraligi}"
                MaxWidth="{StaticResource SayfaGenisligi}"
                HorizontalAlignment="Left">

        <!-- Yazma sirasinda -->
        <StackPanel x:Name="YazmaPaneli" Spacing="{StaticResource KartAraligi}">
            <TextBlock x:Name="AdimAciklamasi" FontSize="15" TextWrapping="Wrap" />
            <ProgressBar x:Name="YazmaCubugu" Maximum="100" Height="4" />

            <!--
              Yuzde tek basina bekleyen birine hicbir sey soylemiyor:
              "%40" bir dakika da olabilir yirmi dakika da. Yaninda
              bayt sayaci ve kalan sure durur.
            -->
            <Grid>
                <TextBlock x:Name="YuzdeMetni" Style="{StaticResource IkincilStili}" />
                <TextBlock x:Name="KalanSureMetni"
                           Style="{StaticResource IkincilStili}"
                           HorizontalAlignment="Right" />
            </Grid>

            <TextBlock x:Name="YazmaUyarisi"
                       Style="{StaticResource IkincilStili}"
                       Opacity="0.55" />
        </StackPanel>

        <!-- Hata -->
        <StackPanel x:Name="HataPaneli"
                    Spacing="{StaticResource KartAraligi}"
                    Visibility="Collapsed">
            <InfoBar x:Name="HataKutusu" Severity="Error" IsOpen="True" IsClosable="False" />

            <Expander x:Name="TeknikBolum" HorizontalAlignment="Stretch">
                <TextBlock x:Name="TeknikMetin"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="12"
                           IsTextSelectionEnabled="True" />
            </Expander>
        </StackPanel>

        <!-- Basarili: BIOS rehberi -->
        <StackPanel x:Name="RehberPaneli"
                    Spacing="{StaticResource SayfaAraligi}"
                    Visibility="Collapsed">

            <InfoBar Severity="Success"
                     IsOpen="True"
                     IsClosable="False"
                     x:Name="BasariKutusu" />

            <!-- Geri okuma dogrulamasinin sonucu -->
            <InfoBar x:Name="DogrulamaKutusu"
                     Severity="Success"
                     IsOpen="True"
                     IsClosable="False"
                     Visibility="Collapsed" />

            <!-- Kurtarma araclari USB'ye yazildiysa -->
            <InfoBar x:Name="KurtarmaKutusu"
                     Severity="Informational"
                     IsOpen="True"
                     IsClosable="False"
                     Visibility="Collapsed" />

            <Border Style="{StaticResource KartStili}">
                <StackPanel Spacing="{StaticResource SatirAraligi}">
                    <TextBlock x:Name="GirisTusuMetni" FontSize="15" TextWrapping="Wrap" />
                    <TextBlock x:Name="BootMenuMetni"
                               FontSize="15"
                               TextWrapping="Wrap"
                               Opacity="0.8" />
                </StackPanel>
            </Border>

            <!--
              Kurulum amacina gore disk secme ekrani tavsiyesi. Bu, USB
              hazir olduktan sonra kullanicinin gorecegi en kritik
              yonergedir ve amaca gore tam tersine donebilir.
            -->
            <Border x:Name="AmacKutusu"
                    Visibility="Collapsed"
                    Style="{StaticResource KartStili}">
                <StackPanel Spacing="{StaticResource SatirAraligi}">
                    <TextBlock x:Name="AmacBasligi" Style="{StaticResource BolumBasligiStili}" />
                    <TextBlock x:Name="AmacMetni" Style="{StaticResource GovdeStili}" />
                </StackPanel>
            </Border>

            <ItemsControl x:Name="AdimListesi">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="14" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Sira}"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Aciklama}" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar x:Name="SecureBootKutusu"
                     Severity="Informational"
                     IsOpen="True"
                     IsClosable="False" />

            <TextBlock x:Name="RehberKaydiMetni" Style="{StaticResource IkincilStili}" />

        </StackPanel>
    </StackPanel>
</Page>
