<ContentDialog
    x:Class="UWin.Uygulama.AraclarPenceresi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  MaxHeight="500"
                  Padding="0,0,18,0"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource SayfaAraligi}" Padding="0,4,4,4">

            <!-- Menu: araclarin listesi -->
            <StackPanel x:Name="MenuPaneli" Spacing="{StaticResource BolumAraligi}">

                <TextBlock x:Name="MenuAciklamasi" Style="{StaticResource GovdeStili}" Opacity="0.75" />

                <ItemsRepeater x:Name="AracListesi">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Button Click="AracSecildi"
                                    Tag="{Binding Kimlik}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="{StaticResource DarKartDolgusu}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="{Binding Simge}"
                                              FontSize="18"
                                              Opacity="0.75"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="{StaticResource DarAralik}">
                                        <TextBlock Text="{Binding Baslik}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Altyazi}"
                                                   Style="{StaticResource IkincilStili}" />
                                    </StackPanel>

                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE76C;"
                                              FontSize="12"
                                              Opacity="0.4"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Secilen aracin icerigi -->
            <StackPanel x:Name="AracPaneli"
                        Spacing="{StaticResource SayfaAraligi}"
                        Visibility="Collapsed">

                <TextBlock x:Name="AracAciklamasi" Style="{StaticResource GovdeStili}" Opacity="0.75" />

                <!-- Disk secimi: kazanma, saglik ve kurtarma araclari kullanir -->
                <StackPanel x:Name="DiskPaneli" Spacing="{StaticResource BolumAraligi}">

                    <TextBlock x:Name="DiskBasligi" Style="{StaticResource BolumBasligiStili}" />

                    <ListView x:Name="DiskListesi"
                              SelectionMode="Single"
                              SelectionChanged="DiskSecildi"
                              MaxHeight="200">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="12,10" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE88E;"
                                              FontSize="16"
                                              Opacity="0.7"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Spacing="{StaticResource DarAralik}">
                                        <TextBlock Text="{Binding Ad}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Ayrinti}"
                                                   Style="{StaticResource IkincilStili}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <InfoBar x:Name="BosListeKutusu"
                             Severity="Informational"
                             IsOpen="True"
                             IsClosable="False"
                             Visibility="Collapsed" />
                </StackPanel>

                <!-- Geri kazanmaya ozel ayarlar -->
                <StackPanel x:Name="KazanmaAyarlari"
                            Spacing="{StaticResource BolumAraligi}"
                            Visibility="Collapsed">

                    <StackPanel Spacing="{StaticResource SatirAraligi}">
                        <TextBlock x:Name="BicimBasligi" Style="{StaticResource BolumBasligiStili}" />
                        <ComboBox x:Name="BicimSecimi" MinWidth="380" SelectedIndex="0" />
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SatirAraligi}">
                        <TextBlock x:Name="EtiketBasligi" Style="{StaticResource BolumBasligiStili}" />
                        <TextBox x:Name="EtiketKutusu" MaxWidth="240" MaxLength="11" Text="USB" />
                    </StackPanel>

                    <TextBlock x:Name="SilmeNotu" Style="{StaticResource IkincilStili}" />
                </StackPanel>

                <!-- Donanim raporu -->
                <StackPanel x:Name="RaporPaneli"
                            Spacing="{StaticResource BolumAraligi}"
                            Visibility="Collapsed">

                    <Border Style="{StaticResource KartStili}">
                        <StackPanel Spacing="{StaticResource SatirAraligi}">
                            <TextBlock x:Name="MakineMetni"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="OzellikMetni"
                                       Style="{StaticResource IkincilStili}"
                                       Opacity="0.7" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="MaddeListesi">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource DarKartStili}"
                                        Padding="0"
                                        Margin="0,0,0,10">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0"
                                                   Fill="{Binding Renk}"
                                                   RadiusX="2"
                                                   RadiusY="2" />

                                        <StackPanel Grid.Column="1"
                                                    Spacing="{StaticResource DarAralik}"
                                                    Padding="0,12,16,12">
                                            <TextBlock Text="{Binding Ad}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Aciklama}"
                                                       Style="{StaticResource IkincilStili}"
                                                       Opacity="0.75" />
                                            <TextBlock Text="{Binding NeYapmali}"
                                                       Visibility="{Binding NeYapmaliGorunurlugu}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       LineHeight="18"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <InfoBar x:Name="UyariKutusu"
                         Severity="Warning"
                         IsOpen="True"
                         IsClosable="False"
                         Visibility="Collapsed" />

                <Button x:Name="CalistirDugmesi"
                        Height="36"
                        MinWidth="160"
                        Visibility="Collapsed"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="CalistirTiklandi" />

                <!-- Islem sirasinda -->
                <StackPanel x:Name="IslemPaneli"
                            Spacing="{StaticResource SatirAraligi}"
                            Visibility="Collapsed">
                    <TextBlock x:Name="IslemMetni" TextWrapping="Wrap" />
                    <ProgressBar x:Name="IslemCubugu" Maximum="100" Height="4" />
                    <TextBlock x:Name="IslemNotu" Style="{StaticResource IkincilStili}" />
                </StackPanel>

                <InfoBar x:Name="SonucKutusu"
                         IsOpen="True"
                         IsClosable="False"
                         Visibility="Collapsed" />

                <HyperlinkButton x:Name="GeriDugmesi" Padding="0" Click="GeriTiklandi" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
