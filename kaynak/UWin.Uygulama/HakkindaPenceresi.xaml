<ContentDialog
    x:Class="UWin.Uygulama.HakkindaPenceresi"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto"
                  MaxHeight="500"
                  Padding="0,0,18,0"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource SayfaAraligi}" Padding="0,4,4,4">

            <!-- Marka -->
            <StackPanel Spacing="{StaticResource SatirAraligi}">
                <TextBlock Text="UWin" FontSize="34" FontWeight="SemiBold" />
                <TextBlock x:Name="TanimMetni"
                           FontSize="15"
                           Opacity="0.75"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock x:Name="AciklamaMetni"
                       Style="{StaticResource GovdeStili}"
                       LineHeight="23"
                       Opacity="0.9" />

            <!--
              Ne yaptigi dort asamada anlatilir: kurulum oncesi, dosya,
              yazma, sonrasi. Bu sira kullanicinin yasadigi siradir -
              ozellikleri onem sirasina dizmek yerine zaman sirasina
              dizmek, programin ne zaman devreye girdigini de anlatiyor.
            -->
            <StackPanel Spacing="{StaticResource BolumAraligi}">
                <TextBlock x:Name="OzellikBasligi" Style="{StaticResource BolumBasligiStili}" />

                <ItemsControl x:Name="OzellikListesi">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="14" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                           Opacity="0.5"
                                           RadiusX="2"
                                           RadiusY="2" />

                                <StackPanel Grid.Column="1" Spacing="{StaticResource DarAralik}">
                                    <TextBlock Text="{Binding Baslik}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Metin}"
                                               TextWrapping="Wrap"
                                               LineHeight="21"
                                               Opacity="0.8" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Araclar -->
            <Border Style="{StaticResource KartStili}">
                <StackPanel Spacing="{StaticResource KartAraligi}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE90F;" FontSize="16" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock x:Name="AraclarBasligi"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl x:Name="AraclarListesi">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#x2022;"
                                               Opacity="0.5"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Güvenlik -->
            <Border Style="{StaticResource KartStili}">
                <StackPanel Spacing="{StaticResource KartAraligi}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72E;"
                                  FontSize="16"
                                  Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="GuvenlikBasligi"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl x:Name="GuvenlikListesi">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#x2022;"
                                               Opacity="0.5"
                                               VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding}"
                                               TextWrapping="Wrap"
                                               LineHeight="20"
                                               Opacity="0.8" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Alt bilgi -->
            <StackPanel Spacing="{StaticResource SatirAraligi}">
                <Border Height="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                        Margin="0,0,0,10" />

                <HyperlinkButton x:Name="SiteBaglantisi"
                                 NavigateUri="https://ugilabs.com"
                                 Padding="0"
                                 FontSize="15"
                                 FontWeight="SemiBold" />

                <TextBlock x:Name="SurumMetni" Style="{StaticResource IkincilStili}" Opacity="0.55" />
                <TextBlock x:Name="TelifMetni" Style="{StaticResource IkincilStili}" Opacity="0.55" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
